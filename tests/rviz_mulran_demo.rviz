Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane: XY
      Color: 160; 160; 160
      Alpha: 0.3
      Line Style:
        Type: Lines
        Line Width: 0.03
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz/PointCloud2
      Enabled: true
      Name: Ouster Points
      Topic: /os1_points
      Queue Size: 10
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Color Transformer: FlatColor
      Use rainbow: false
      Color: 255; 255; 255
      Autocompute Intensity Bounds: true
      Axis: Z
      Decay Time: 0
      Unreliable: false
    - Class: rviz/Odometry
      Enabled: true
      Name: LIO Odometry
      Topic: /lio_sam/mapping/odometry
      Shape: Arrow
      Color: 25; 255; 0
      Shaft Length: 0.5
      Shaft Radius: 0.02
      Head Length: 0.1
      Head Radius: 0.05
      Keep: 1000
      Position Tolerance: 0.0
      Angle Tolerance: 0.0
      Alpha: 1
    - Class: rviz/Image
      Enabled: true
      Name: Radar Polar
      Topic: /radar/polar
      Queue Size: 2
      Transport Hint: raw
      Normalize Range: true
      Min Value: 0
      Max Value: 255
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/Select
    - Class: rviz/Measure
    - Class: rviz/MoveCamera
    - Class: rviz/Orbit
    - Class: rviz/FocusCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/Orbit
      Target Frame: map
      Distance: 50
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 0.5
      Near Clip Distance: 0.01
      Focal Shape Size: 0.05
      Focal Shape Fixed Size: true
      Name: Orbit
    Saved: []
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: ""
  Width: 1200
  X: 50
  Y: 50
